# Copy to .env.local and fill in. NEXT_PUBLIC_* values are visible in the browser;
# everything else stays on the server. Never put a secret in a NEXT_PUBLIC_* value.

# WhatsApp number that all booking links open, digits only with country code.
NEXT_PUBLIC_WA_NUMBER=

# Search indexing. Leave blank until launch; set to "true" only on the real domain.
NEXT_PUBLIC_ALLOW_INDEXING=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Blank disables tracking.
NEXT_PUBLIC_GA_ID=

# --- Admin dashboard at /dashboard ---
# Login for the dashboard. It returns 503 until both are set.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Read-only Google Cloud service account with Viewer access to the GA4 property.
# Paste the private key in quotes, keeping its \n sequences.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# "true" shows clearly labelled invented numbers, for demos before real traffic.
DASHBOARD_SAMPLE_DATA=
