# Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are bundled into the browser build and are public.
# Everything else stays server-side - never prefix a secret with NEXT_PUBLIC_.

# Operator WhatsApp number - digits only, country code, no "+" or spaces.
# Booking links silently break if this is left as the placeholder.
NEXT_PUBLIC_WA_NUMBER=628XXXXXXXXXX

# Google Tag Manager container. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GTM_ID=

# Canonical origin, used for metadata, OpenGraph and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://baliwateractivity.com

# --- Operator dashboard (/dashboard) ---
# Both are required; the dashboard returns 503 until they are set.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Google Analytics 4 Data API, read-only service account.
# GA4_PRIVATE_KEY keeps its literal backslash-n sequences - paste it in quotes.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Renders the dashboard with clearly-labelled fake numbers for client demos.
# Never enable in production.
DASHBOARD_SAMPLE_DATA=false
