# Copy to .env.local and fill in. All values are exposed to the browser.

# Operator WhatsApp number — digits only, country code, no "+" or spaces.
# Booking links silently break if this is left as the placeholder.
NEXT_PUBLIC_WA_NUMBER=628XXXXXXXXXX

# Google Tag Manager container. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GTM_ID=

# Canonical origin, used for metadata, OpenGraph and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://baliwateractivity.com
